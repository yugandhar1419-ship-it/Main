def print_board(a):
    for row in a:
        for cell in row:
            print("", cell, "", end="")
        print()


def change(n, p, a):
    
    pos = {
        1: (0, 0), 2: (0, 1), 3: (0, 2),
        4: (1, 0), 5: (1, 1), 6: (1, 2),
        7: (2, 0), 8: (2, 1), 9: (2, 2)
    }
    r, c = pos[n]
    a[r][c] = p
    return a


def draw_check(a):
    for row in a:
        for cell in row:
            if '1' <= cell <= '9':
                return False
    return True


def check(a):
    
    for i in range(3):
        if a[i][0] == a[i][1] == a[i][2] and (a[i][0] in ['X', 'O']):
            return False

    
    for j in range(3):
        if a[0][j] == a[1][j] == a[2][j] and (a[0][j] in ['X', 'O']):
            return False

    
    if a[0][0] == a[1][1] == a[2][2] and (a[0][0] in ['X', 'O']):
        return False
    if a[0][2] == a[1][1] == a[2][0] and (a[0][2] in ['X', 'O']):
        return False

    return True


def play(p1, p2, a):
    num = [1, 2, 3, 4, 5, 6, 7, 8, 9]

    while True:
        
        while True:
            n = int(input("player1 enter one number (1-9): "))
            if n in num:
                num.remove(n)
                break
            print("Invalid move, choose another space:")

        a = change(n, p1, a)
        print_board(a)

        if not check(a):
            print("Player 1 is the winner 🥳")
            return

        if draw_check(a):
            print("The match is Draw")
            return

        
        while True:
            n = int(input("player2 enter one number (1-9): "))
            if n in num:
                num.remove(n)
                break
            print("Invalid move, choose another space:")

        a = change(n, p2, a)
        print_board(a)

        if not check(a):
            print("Player 2 is the winner 🥳")
            return

        if draw_check(a):
            print("The match is Draw")
            return


